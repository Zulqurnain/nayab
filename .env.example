# Nayab — Environment Variables
# Copy this to .env.local and fill in values.
# NEVER commit .env.local to git.

# Port
PORT=3002
HOSTNAME=127.0.0.1

# offLLama — self-hosted inference server (free tier)
OFFLLAMA_URL=http://127.0.0.1:8080
OFFLLAMA_API_KEY=

# Paid tier — OpenAI
OPENAI_API_KEY=

# Paid tier — Anthropic
ANTHROPIC_API_KEY=

# Gumroad license verification
GUMROAD_PRODUCT_ID=

# App URL
NEXT_PUBLIC_APP_URL=https://zulqurnainj.com/chat

# Database (Layer 3)
DB_PATH=/var/data/nayab.db

# Logging (Layer 12)
LOG_DIR=/var/log/nayab
LOG_LEVEL=info

# Auth (Layer 4) — REQUIRED: generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=https://zulqurnainj.com/chat

# Error tracking (Layer 12) — optional, leave empty to disable
SENTRY_DSN=

# CORS — comma-separated allowed origins (Layer 8)
ALLOWED_ORIGINS=https://zulqurnainj.com
