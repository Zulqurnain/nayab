# Nayab — Environment Variables
# Copy this to .env.local and fill in values.
# NEVER commit .env.local to git.

# Port
PORT=3002

# offLLama — self-hosted inference server (free tier)
# URL of your running offLLama server
OFFLLAMA_URL=http://127.0.0.1:8080
# Optional bearer token for the offLLama server
OFFLLAMA_API_KEY=

# Paid tier — OpenAI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Paid tier — Anthropic
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gumroad license verification
# Your Gumroad product ID (found in Gumroad product URL)
GUMROAD_PRODUCT_ID=

# App URL (used in metadata)
NEXT_PUBLIC_APP_URL=https://chat.zulqurnainj.com
